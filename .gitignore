# pixi 环境（数百 MB，绝不入库）—— 可复现性由 pixi.lock 保证
.pixi/

# Mojo / Python 构建产物
__pycache__/
*.py[cod]
*.mojoc
build/
dist/
.mojo-version

# 模型权重与数据（体积大、非源码）
models/
*.gguf
*.safetensors
*.bin
*.pt

# 文档构建输出
site/

# 编译出的测试可执行文件（pixi run test-model 会生成）
target/

# 整网参数导出（约 2 GB，由 scripts/dump_model_reference.py --full 本地重建）
# 逐算子小切片（layer0/，约 9 MB）是入 fixture，不在此列。
tests/fixtures/*/weights/

# 编辑器与系统
.idea/
.vscode/
*.swp
.DS_Store

# 本地临时文件
*.log
tmp/

# AI 工具本地工作数据（含对项目的内部判断，不属于源码）
.codebuddy/

# 测试夹具中的模型权重（1.9 GB，不入库；其余小夹具需要入库，CI 依赖它们）
tests/fixtures/qwen2.5-0.5b/weights/tensors.f32

# 例外：这两处是量化网格的夹具，不是模型权重，CI 依赖它们（曾被 *.bin 连带忽略）
!tests/fixtures/qwen2.5-0.5b/q4/blocks.bin
# `q4vec/` 是给融合 matmul 的向量化差分门用的形状夹具（约 48 KB），理由同上。
!tests/fixtures/qwen2.5-0.5b/q4vec/blocks.bin
